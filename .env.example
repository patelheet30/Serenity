TOKEN=xxxx-xxxx-xxxx-xxxx
LOG_LEVEL=INFO
# Postgres (docker compose passes these to the bot as PGUSER/PGPASSWORD/PGDATABASE)
# Generate with: openssl rand -hex 24
POSTGRES_USER=serenity
POSTGRES_PASSWORD=
POSTGRES_DB=serenity
# Bot connection pool size (default 5)
# DB_POOL_SIZE=5

# Port for /metrics and /health (default 8080). Also sets the published port and the
# container healthcheck in docker-compose.yml, so change it here rather than in code.
# METRICS_PORT=8080

# Dashboard login (Discord OAuth2). Client id/secret from the Discord developer portal
# (OAuth2 page); add <DASHBOARD_URL>/api/auth/callback there as a redirect.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# Public URL of the dashboard (default http://localhost:5173 for local dev)
# DASHBOARD_URL=https://serenity.example.com
# Encrypts stored Discord tokens. Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DASHBOARD_SECRET=
