# TLS terminates at Nginx Proxy Manager on the VM, which forwards the dashboard domain here.
{
	auto_https off
	admin off
}

:80 {
	encode zstd gzip

	# Only /api reaches the bot; /metrics and /health stay off the public site.
	handle /api/* {
		reverse_proxy serenity:{$METRICS_PORT:8080}
	}

	# Hashed build assets: real files only, never the SPA fallback. A chunk removed by a later
	# deploy must 404, not be cached for a year as 200.html.
	handle /_app/immutable/* {
		root * /srv
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		try_files {path} {path}.html /200.html
		file_server
	}
}
